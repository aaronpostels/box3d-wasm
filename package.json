{
  "name": "box3d-wasm",
  "version": "0.2.0",
  "description": "Box3D (Erin Catto) as WebAssembly, rebuilt automatically from upstream. JS wrapper and a Rust crate.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./dist/box3d.wasm",
    "./raw": "./dist/box3d.js"
  },
  "files": [
    "dist",
    "src/c",
    "src/ts",
    "crates/box3d-sys",
    "vendor/box3d/include",
    "vendor/box3d/src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "build": "npm run build:wasm && npm run build:ts",
    "build:wasm": "bash scripts/build.sh simd && bash scripts/build.sh scalar && bash scripts/build.sh threads",
    "build:ts": "tsc",
    "test": "node test/smoke.mjs && node test/snapshot.mjs",
    "update:upstream": "git submodule update --remote --merge vendor/box3d"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "keywords": [
    "physics",
    "3d",
    "box3d",
    "webassembly",
    "wasm",
    "simd",
    "game-engine"
  ],
  "author": "Aaron",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronpostels/box3d-wasm.git"
  }
}
